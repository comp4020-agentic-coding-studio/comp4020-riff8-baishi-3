---
import { JOBS, type JobId } from "../game/data.ts";
import { currentChar } from "../server/auth.ts";
import { characterCount, topCharacters } from "../server/db.ts";
import { onlineSummary } from "../server/world.ts";
import "../client/style.css";

// Rendered on the server every time, so the page says something real with
// JavaScript off: who's in the world now, the longest-standing adventurers,
// and a plain form to make a character.
const me = currentChar(Astro.cookies);
const online = onlineSummary();
const top = topCharacters(8);
const total = characterCount();
const error = Astro.url.searchParams.get("error");
const jobs = Object.entries(JOBS) as [JobId, (typeof JOBS)[JobId]][];
const sprite = (i: number) => `background-position:-${(i % 12) * 48}px -${Math.floor(i / 12) * 48}px`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hollowfield</title>
    <meta name="description" content="A small shared-world RPG: three jobs, one village, monsters that are better fought together." />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class={me ? "playing" : "landing"}>
    {
      me ? (
        <div id="app" data-name={me.name}>
          <header class="top">
            <h1>Hollowfield</h1>
            <span id="mapname" />
            <span id="conn" />
            <a href="/readme/">About</a>
          </header>
          <main class="stage">
            <div id="announce" role="status" aria-live="polite" />
            <canvas id="game" tabindex="0" aria-label="The game world. Click to move or attack; arrow keys step, A attacks the nearest monster, 1 to 4 use skills." />
            <div id="target" class="target" hidden />
            <div id="modal" class="modal" hidden />
          </main>
          <aside class="side">
            <section id="bars" class="frame" />
            <nav id="tabs" class="tabs">
              <button data-tab="status" class="on">Status</button>
              <button data-tab="skills">Skills</button>
              <button data-tab="bag">Bag</button>
              <button data-tab="party">Party</button>
              <button data-tab="help">Help</button>
            </nav>
            <section id="panel" class="frame panel" />
          </aside>
          <section class="chatbox frame">
            <div id="log" class="log" aria-live="polite" />
            <form id="chat">
              <select name="scope" aria-label="chat channel">
                <option value="say">Say</option>
                <option value="party">Party</option>
                <option value="guild">Guild</option>
              </select>
              <input name="text" maxlength="120" autocomplete="off" placeholder="Enter to chat" aria-label="message" />
            </form>
          </section>
          <noscript><p class="frame">The world needs JavaScript to play. Your character, {me.name}, is safe.</p></noscript>
        </div>
      ) : (
        <main class="landing-main">
          <section class="hero frame">
            <h1>Hollowfield</h1>
            <p class="lede">
              An autumn village at the edge of the Amber Fields. Mosslings eat what nobody picks up, bristlerats bite,
              and the Ember Crab comes back every three minutes. Nobody here gets far alone.
            </p>
            <p>
              <strong>{online.length}</strong> {online.length === 1 ? "adventurer is" : "adventurers are"} in the world now
              {online.length > 0 && <>: {online.map((o, i) => <>{i > 0 && ", "}{o.name} <small>({JOBS[o.job].name} {o.level}, {o.map})</small></>)}</>}.{" "}
              {total} {total === 1 ? "has" : "have"} ever set out.
            </p>
          </section>

          <section class="frame create">
            <h2>Make a character</h2>
            {error && <p class="error" role="alert">{error}</p>}
            <form method="post" action="/api/character" id="create">
              <label>Name <input name="name" required minlength="3" maxlength="16" pattern="[A-Za-z][A-Za-z0-9 _'\-]{1,14}[A-Za-z0-9]" autocomplete="off" /></label>
              <fieldset>
                <legend>Job</legend>
                <div class="jobs">
                  {jobs.map(([id, j], i) => (
                    <label class="job">
                      <input type="radio" name="job" value={id} required checked={i === 0} />
                      <span class="sprite" style={sprite(j.sprite.i)} />
                      <strong>{j.name}</strong> <small>{j.role}</small>
                      <span>{j.blurb}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <button type="submit">Enter Hollowfield</button>
              <p class="hint">No account, no email. Your character lives in this browser (a cookie). Another browser profile makes another character.</p>
            </form>
          </section>

          <section class="frame">
            <h2>Longest on the road</h2>
            {top.length ? (
              <ol>{top.map((c) => <li>{c.name} <small>— {JOBS[c.job].name}, level {c.level}</small></li>)}</ol>
            ) : (
              <p>Nobody yet. Be the first.</p>
            )}
            <p><a href="/readme/">What this is, the rules the server enforces, and why</a>.</p>
          </section>
        </main>
      )
    }
    <script>
      import { loadSheets } from "../client/sprites.ts";
      import { start } from "../client/game.ts";
      const canvas = document.querySelector<HTMLCanvasElement>("#game");
      if (canvas) {
        await document.fonts.load('16px "Kenney Pixel"').catch(() => {});
        await loadSheets();
        start(canvas);
      }
    </script>
  </body>
</html>
