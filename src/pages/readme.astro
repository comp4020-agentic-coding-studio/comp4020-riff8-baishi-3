---
import { marked } from "marked";
import readmeSource from "../../README.md?raw";
import "../client/style.css";

const body = marked.parse(readmeSource, { async: false }) as string;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About &mdash; Hollowfield</title>
    <meta
      name="description"
      content="What Hollowfield is, and the rules its server enforces."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header>
      <p class="back"><a href="/">&larr; back to Hollowfield</a></p>
    </header>
    <main class="readme frame" set:html={body} />
  </body>
</html>

<style>
  .readme {
    max-width: 46rem;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }
  .readme :global(h1) {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .readme :global(code) {
    background: rgb(0 0 0 / 25%);
    padding: 0 0.25em;
  }
</style>
