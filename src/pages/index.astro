---
import "../styles/global.css";
import { getAllStrokes } from "../lib/db";
import { echoFor } from "../lib/echo";
import { HEIGHT, SEGMENT, SOFT_SPREAD, totalWidth, zoneStart } from "../lib/layout";

const strokes = getAllStrokes();
const count = strokes.length;
const width = totalWidth(count);
const zoneX = zoneStart(count);
const echo = echoFor(strokes[count - 1], count);

const since =
  count > 0
    ? new Date(strokes[0].createdAt).toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Scroll</title>
    <meta
      name="description"
      content="A shared ink scroll that only ever grows: one mark per visit, none of them ever erased."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <h1>The Scroll</h1>
      <p class="tagline">
        One mark, then it stays. <a href="/readme/">What this is, and why</a>.
      </p>
      <div id="controls" class="controls"></div>
    </header>

    <main>
      <div id="canvas-wrap">
        <svg
          id="scroll"
          viewBox={`0 0 ${width} ${HEIGHT}`}
          width={width}
          height={HEIGHT}
          aria-label={`A shared ink scroll of ${count} mark${count === 1 ? "" : "s"} left so far, with a blank space at the end for yours`}
        >
          <rect x="0" y="0" width={width} height={HEIGHT} class="paper" />

          {
            strokes.map((s) => (
              <g class="mark" data-t={s.createdAt}>
                <path d={s.d} class="ink-soft" stroke-width={s.width * SOFT_SPREAD} />
                <path d={s.d} class="ink" stroke-width={s.width} />
              </g>
            ))
          }

          {
            echo && (
              <g id="echo">
                <linearGradient
                  id="echo-fade"
                  gradientUnits="userSpaceOnUse"
                  x1={echo.x1}
                  y1={echo.y1}
                  x2={echo.x2}
                  y2={echo.y2}
                >
                  <stop offset="0" class="echo-stop" stop-opacity="0.9" />
                  <stop offset="0.6" class="echo-stop" stop-opacity="0.45" />
                  <stop offset="1" class="echo-stop" stop-opacity="0" />
                </linearGradient>
                <path
                  d={`M ${echo.x1} ${echo.y1} L ${echo.x2} ${echo.y2}`}
                  class="echo"
                  stroke-width={Math.max(5, echo.width * 0.8)}
                />
              </g>
            )
          }

          <rect
            id="zone-outline"
            x={zoneX + 4}
            y="4"
            width={SEGMENT - 8}
            height={HEIGHT - 8}
            class="zone-outline"
          />
          <text id="zone-prompt" x={zoneX + SEGMENT / 2} y={HEIGHT / 2} class="zone-prompt">
            {echo ? "continue their line" : "draw here"}
          </text>
          <path id="preview" d="" class="ink" />
          <rect
            id="zone-hit"
            x={zoneX}
            y="0"
            width={SEGMENT}
            height={HEIGHT}
            class="zone-hit"
            tabindex="0"
            role="button"
            aria-label={`Draw your mark here${echo ? ", where a dotted trail continues the last mark" : ""}: drag with a pointer, or press Enter or Space to leave a dot`}
          />
        </svg>
      </div>

      <p id="status" class="status" aria-live="polite">
        {count === 0
          ? "Nobody has drawn yet. The blank strip at the right is where you go first."
          : `${count} mark${count === 1 ? "" : "s"} so far, since ${since}.`}
      </p>
      <p id="presence" class="status presence" aria-live="polite"></p>
    </main>

    <script>
      import { initDrawing } from "../lib/draw";
      import { initLanterns } from "../lib/lanterns";
      import { initReplay } from "../lib/replay";

      initDrawing(document);
      initReplay(document);

      const wrap = document.getElementById("canvas-wrap");
      if (wrap) wrap.scrollLeft = wrap.scrollWidth;
      initLanterns(document);
    </script>
  </body>
</html>
